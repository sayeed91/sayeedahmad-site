---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

// A muted, looping video that only loads and plays while it's on screen, so a
// page full of them stays light. Until then (and always, for people who ask
// for reduced motion) the poster shows, which is the video's first frame.
// It's a custom element so it also works when the home sheet clones a page in.
interface Props {
  src: string;
  poster: ImageMetadata;
  label: string;
  width: number;
  height: number;
  class?: string;
}
const { src, poster, label, width, height, class: className } = Astro.props;
const posterImg = await getImage({ src: poster, width, format: 'webp', quality: 86 });
---

<loop-video class={className}>
  <video
    src={src}
    poster={posterImg.src}
    width={width}
    height={height}
    aria-label={label}
    muted
    loop
    playsinline
    preload="none"
    disablepictureinpicture
  ></video>
</loop-video>

<style>
  loop-video {
    display: block;
  }
  video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>

<script>
  class LoopVideo extends HTMLElement {
    io?: IntersectionObserver;

    connectedCallback() {
      const video = this.querySelector('video');
      if (!video || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      // A cloned <video> loses the muted property, and browsers only autoplay muted video.
      video.muted = true;
      this.io = new IntersectionObserver(
        ([entry]) => {
          if (entry.isIntersecting) video.play().catch(() => {});
          else video.pause();
        },
        { threshold: 0.2 },
      );
      this.io.observe(this);
    }

    disconnectedCallback() {
      this.io?.disconnect();
    }
  }

  if (!customElements.get('loop-video')) customElements.define('loop-video', LoopVideo);
</script>

---
// "Message me" form. Netlify Forms picks up the static form at build time
// (data-netlify), and the script below posts it without leaving the page.
---

<dialog id="message-dialog" class="message" aria-labelledby="message-title">
  <form
    name="contact"
    method="POST"
    data-netlify="true"
    netlify-honeypot="company-website"
    class="message__form"
  >
    <input type="hidden" name="form-name" value="contact" />
    <p class="visually-hidden">
      <label>Leave this empty <input name="company-website" tabindex="-1" autocomplete="off" /></label>
    </p>
    <div class="message__head">
      <h2 id="message-title" class="message__title">Message Sayeed</h2>
      <button type="button" class="message__close" data-close aria-label="Close">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path d="M4 4l8 8M12 4l-8 8"></path></svg>
      </button>
    </div>
    <label class="field">
      <span class="field__label">Name</span>
      <input class="field__input" name="name" required autocomplete="name" placeholder="Your name" />
    </label>
    <label class="field">
      <span class="field__label">Email</span>
      <input class="field__input" type="email" name="email" required autocomplete="email" placeholder="you@company.com" />
    </label>
    <label class="field">
      <span class="field__label">Message</span>
      <textarea class="field__input field__input--area" name="message" required placeholder="What are you working on?"></textarea>
    </label>
    <button type="submit" class="message__send">Send message</button>
    <p class="message__status" role="status" aria-live="polite"></p>
  </form>
</dialog>

<style>
  .message {
    width: 360px;
    max-width: calc(100vw - 32px);
    margin: 0;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: 16px;
    background: var(--surface);
    color: var(--text-primary);
    box-shadow: 0 16px 40px rgba(10, 13, 20, 0.14);
    position: fixed;
    inset: auto;
  }
  .message::backdrop {
    background: transparent;
  }
  .message__form {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 20px;
  }
  .message__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .message__title {
    font-size: 16px;
    line-height: 24px;
    font-weight: 500;
  }
  .message__close {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    margin: -4px -6px -4px 0;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--text-secondary);
    cursor: pointer;
  }
  .message__close:hover {
    background: var(--bg);
  }
  .field {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .field__label {
    font-size: 13px;
    line-height: 18px;
    font-weight: 500;
    color: var(--text-secondary);
  }
  .field__input {
    width: 100%;
    padding: 10px 12px;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--bg);
    font: inherit;
    font-size: 14px;
    line-height: 20px;
    color: var(--text-primary);
  }
  .field__input::placeholder {
    color: var(--text-tertiary);
  }
  .field__input:focus {
    outline: none;
    border-color: var(--text-secondary);
    background: var(--surface);
  }
  .field__input--area {
    height: 104px;
    resize: vertical;
  }
  .message__send {
    padding: 10px 20px;
    border: 0;
    border-radius: 999px;
    background: var(--text-primary);
    color: var(--on-primary);
    font-size: 14px;
    line-height: 20px;
    font-weight: 500;
    cursor: pointer;
  }
  .message__send[disabled] {
    opacity: 0.6;
    cursor: default;
  }
  .message__status {
    font-size: 13px;
    line-height: 18px;
    color: var(--text-secondary);
  }
  .message__status:empty {
    display: none;
  }
  @media (max-width: 640px) {
    .message {
      left: 16px !important;
      right: 16px;
      top: auto !important;
      bottom: 16px;
      width: auto;
    }
  }
</style>

<script>
  // The home sheet can load a case page's bundle that includes this script
  // again, so it must only ever wire itself up once.
  const w = window as unknown as { __messageReady?: boolean };
  if (!w.__messageReady) {
  w.__messageReady = true;
  const dialog = document.getElementById('message-dialog') as HTMLDialogElement;
  const form = dialog.querySelector('form') as HTMLFormElement;
  const status = dialog.querySelector('.message__status') as HTMLElement;
  const send = dialog.querySelector('.message__send') as HTMLButtonElement;

  // Opens under whichever "Message me" button was pressed, right-aligned to it.
  const open = (trigger: HTMLElement) => {
    const r = trigger.getBoundingClientRect();
    dialog.style.top = `${r.bottom + 8}px`;
    dialog.style.left = `${Math.max(16, Math.min(r.right - 360, window.innerWidth - 376))}px`;
    status.textContent = '';
    dialog.showModal();
  };

  document.addEventListener('click', (e) => {
    const trigger = (e.target as HTMLElement).closest<HTMLElement>('[data-action="message"]');
    if (trigger) {
      e.preventDefault();
      open(trigger);
    }
  });

  dialog.querySelector('[data-close]')?.addEventListener('click', () => dialog.close());
  // A click on the backdrop lands on the dialog element itself.
  dialog.addEventListener('click', (e) => {
    if (e.target === dialog) dialog.close();
  });

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    send.disabled = true;
    status.textContent = 'Sending…';
    try {
      const body = new URLSearchParams(new FormData(form) as unknown as Record<string, string>);
      const res = await fetch('/', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: body.toString(),
      });
      if (!res.ok) throw new Error(String(res.status));
      form.reset();
      status.textContent = 'Sent. I’ll reply by email.';
    } catch {
      status.textContent = 'That didn’t go through. Email me at ahmadsayeed1991@gmail.com instead.';
    } finally {
      send.disabled = false;
    }
  });
  }
</script>

---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

// Figures are exported from Figma at 2x (1280px wide) and served as
// responsive AVIF/WebP. The panel, radius and padding live inside the export.
interface Props {
  src: ImageMetadata;
  alt: string;
  eager?: boolean;
}
const { src, alt, eager = false } = Astro.props;
---

<figure class="fig">
  <Image
    src={src}
    alt={alt}
    widths={[640, 960, 1280]}
    sizes="(max-width: 680px) calc(100vw - 40px), 640px"
    loading={eager ? 'eager' : 'lazy'}
    format="webp"
    quality={86}
  />
</figure>

<style>
  .fig img {
    width: 100%;
    height: auto;
  }
</style>

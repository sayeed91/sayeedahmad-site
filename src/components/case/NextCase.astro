---
import { Image } from 'astro:assets';
import Icon from '../Icon.astro';
import { nextCase, type CaseSlug } from '../../data/site';

interface Props {
  current: CaseSlug;
}
const next = nextCase(Astro.props.current);
---

<a class="next" href={`/work/${next.slug}`} data-sheet>
  <span class="next__text">
    <span class="next__label">Next case study</span>
    <span class="next__row">
      <span class="next__title">{next.title}</span>
      <Icon name="arrow-right" />
    </span>
  </span>
  <span class="next__thumb">
    <Image src={next.thumb} alt="" widths={[200, 400]} sizes="200px" />
  </span>
</a>

<style>
  .next {
    display: flex;
    align-items: center;
    gap: 20px;
    padding-top: 28px;
    border-top: 1px solid var(--line);
  }
  .next__text {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }
  .next__label {
    font-size: 13px;
    line-height: 18px;
    color: var(--text-tertiary);
  }
  .next__row {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 18px;
    line-height: 26px;
    font-weight: 500;
  }
  .next__row :global(svg) {
    flex-shrink: 0;
    transition: transform 200ms ease;
  }
  .next:hover .next__row :global(svg) {
    transform: translateX(3px);
  }
  .next__thumb {
    width: 200px;
    height: 74px;
    flex-shrink: 0;
    border-radius: 10px;
    overflow: hidden;
  }
  .next__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  @media (max-width: 560px) {
    .next__thumb {
      display: none;
    }
  }
</style>

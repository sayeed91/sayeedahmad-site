---
interface Props {
  title: string;
  tags: string[];
  lede: string;
}
const { title, tags, lede } = Astro.props;
---

<header class="intro">
  <h1 class="intro__title">{title}</h1>
  <ul class="intro__tags">
    {tags.map((t) => <li class="tag">{t}</li>)}
  </ul>
  <p class="intro__lede">{lede}</p>
  <slot />
</header>

<style>
  .intro {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .intro__title {
    font-size: 34px;
    line-height: 42px;
    font-weight: 500;
    letter-spacing: -0.68px;
  }
  .intro__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .tag {
    padding: 4px 10px;
    border-radius: 999px;
    background: var(--bg);
    font-size: 13px;
    line-height: 18px;
    color: var(--text-secondary);
  }
  .intro__lede {
    color: var(--text-secondary);
  }
  @media (max-width: 640px) {
    .intro__title {
      font-size: 28px;
      line-height: 36px;
      letter-spacing: -0.5px;
    }
  }
</style>

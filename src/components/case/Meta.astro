---
interface Props {
  rows: [string, string][];
}
const { rows } = Astro.props;
---

<dl class="meta">
  {
    rows.map(([k, v]) => (
      <div class="meta__row">
        <dt>{k}</dt>
        <dd>{v}</dd>
      </div>
    ))
  }
</dl>

<style>
  .meta {
    margin: 0;
    border-top: 1px solid var(--line);
    font-size: 14px;
    line-height: 22px;
  }
  .meta__row {
    display: flex;
    gap: 24px;
    padding: 12px 0;
    border-bottom: 1px solid var(--line);
  }
  dt {
    width: 140px;
    flex-shrink: 0;
    color: var(--text-tertiary);
  }
  dd {
    margin: 0;
    font-weight: 500;
  }
  @media (max-width: 480px) {
    dt {
      width: 96px;
    }
  }
</style>

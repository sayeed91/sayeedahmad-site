---
import Base from './Base.astro';
import InnerHeader from '../components/InnerHeader.astro';

interface Props {
  title: string;
  description: string;
  image?: string;
}
const { title, description, image } = Astro.props;
---

<Base title={`${title} · Sayeed Ahmad`} description={description} surface="white" image={image}>
  <InnerHeader />
  <!-- The sheet overlay on the home page lifts exactly this element. -->
  <main class="case-body" data-sheet-body>
    <slot />
  </main>
</Base>

<style>
  .case-body {
    width: min(var(--column), 100% - var(--gutter) * 2);
    margin: 0 auto;
    padding: 56px 0 96px;
    display: flex;
    flex-direction: column;
    gap: 72px;
  }
  @media (max-width: 640px) {
    .case-body {
      padding-top: 40px;
      gap: 56px;
    }
  }
</style>
